# Copy to .env and fill in. Never commit .env.
# Variables marked (optional in dev) fall back to a local stub when empty; they are required in production.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL, no trailing slash (used for OG images, sitemap, payment return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# PostgreSQL (Supabase or Neon in production). Local dev uses the Docker container from docs/HANDOFF.md.
DATABASE_URL=postgresql://esports:esports_local@localhost:5440/esports
# Separate database used by the Vitest integration tests and Playwright (never point at production)
TEST_DATABASE_URL=postgresql://esports:esports_local@localhost:5440/esports_test
# Separate database for Playwright (reset and seeded before every e2e run)
E2E_DATABASE_URL=postgresql://esports:esports_local@localhost:5440/esports_e2e

# Signs the session JWT cookie. At least 32 random characters: `openssl rand -base64 48`
SESSION_SECRET=

# Phone (E.164, e.g. +919876543210) of the first ADMIN user created by `npm run db:seed`
ADMIN_PHONE=

# Shared secret for /api/cron/* (Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# ---------------------------------------------------------------------------
# Firebase Phone Auth (OTP)  (optional in dev: empty = local OTP stub, code 123456)
# ---------------------------------------------------------------------------
# Client SDK config (Firebase console -> Project settings -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# "off" hides phone login (Google + email only). New Firebase projects send no SMS until a
# billing account (Blaze plan) is linked; switch it back on (remove or "on") once it is.
NEXT_PUBLIC_PHONE_LOGIN=on
# Local OTP stub (dev/tests only): "true" lets the login form accept code 123456 when the Firebase
# admin credentials below are empty. Refused on the Vercel production deployment. Never set in production.
AUTH_OTP_STUB=false
# Admin SDK service account (Project settings -> Service accounts -> Generate new private key)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n sequences; they are converted to newlines at runtime
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# File storage: Supabase Storage (optional in dev: empty = local disk under .uploads/)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ---------------------------------------------------------------------------
# Payments: Cashfree PG (entry fees) + Cashfree Payouts (prizes)  (Phase 6)
# ---------------------------------------------------------------------------
# "true" enables paid-entry matches. Keep "false" until the legal review in docs/SPEC.md is done.
PAYMENTS_ENABLED=false
# sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_PAYOUTS_CLIENT_ID=
CASHFREE_PAYOUTS_CLIENT_SECRET=
# Payouts above this amount (paise) need a second admin approval. Default 500000 = INR 5,000
PAYOUT_TWO_STEP_THRESHOLD_PAISE=500000

# ---------------------------------------------------------------------------
# Web Push (Phase 7). Generate with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for the push service
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Email via Resend: login codes, email verification, notification copies
# (optional in dev: empty = emails are printed in the server console; required in production)
# ---------------------------------------------------------------------------
# resend.com -> API Keys
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Esports <no-reply@yourdomain.in>"
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Monitoring (Phase 8)  (optional: empty disables Sentry)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
